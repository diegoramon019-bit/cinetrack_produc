{
  "expo": {
    "name": "CineTrack",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cinetrack-logo.png",
    "scheme": "cinetrack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diegdev.cinetrack"
    },
    "android": {
      "package": "com.diegdev.cinetrack",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cinetrack-logo.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/images/cinetrack-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cinetrack-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf0be5bb-6f82-49bb-9c15-83c0df419445"
      }
    },
    "owner": "dieguito05"
  }
}
